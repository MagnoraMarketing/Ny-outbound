# Kopiér til .env.local og udfyld værdierne. De samme nøgler sættes under
# Settings → Environment Variables i Vercel.

# --- Supabase (påkrævet) ---------------------------------------------------
# Project Settings → API. URL'en skal være en fuld adresse med https:// foran
# og uden anførselstegn - ellers ender appen på opsætningssiden.
NEXT_PUBLIC_SUPABASE_URL=https://dit-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telnyx (telefoni) -----------------------------------------------------
# Uden dem virker resten af appen, men der kan ikke ringes.
# API-nøgle og public key: Auth → API Keys / Public Key.
# Connection ID: Call Control-applikationen under Voice.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=

# --- Claude (AI-analyse) ---------------------------------------------------
# Uden den springes analysen af samtalen over.
ANTHROPIC_API_KEY=

# --- Appens egen adresse (kun uden for Vercel) -----------------------------
# Bruges til at fortælle Telnyx hvor webhooken skal sendes hen.
#
# På Vercel bliver denne IGNORERET: platformen kender selv projektets
# adresse, også ved eget domæne, og den værdi kan ikke blive forældet.
# Sæt den kun ved lokal kørsel eller egen hosting. Uden skråstreg til sidst.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
